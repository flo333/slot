diff --git a/src/gba/audio.c b/src/gba/audio.c
index 278e878..3d3353e 100644
--- a/src/gba/audio.c
+++ b/src/gba/audio.c
@@ -453,6 +453,18 @@ void GBAAudioSerialize(const struct GBAAudio* audio, struct GBASerializedState*
 	}
 	STORE_32(audio->lastSample, 0, &state->audio.lastSample);
 
+	// The GB channels' frequencies sit in write-only register bits, which the IO block keeps
+	// masked off, channel 3's output is not in the wave RAM it rotates through, and channel 4
+	// averages the noise it ran since it was last mixed. Without these, a load restarts
+	// channels 1-3 at frequency 0, channels 3 and 4 on a stale output and channel 4 on no
+	// average. Channel 4's output fits in the five bits above channel 3's 11-bit rate.
+	STORE_32(audio->psg.ch1.control.frequency, 0, &state->audio.psg.ch1.reserved);
+	STORE_32(audio->psg.ch2.control.frequency, 0, &state->audio.psg.ch2.reserved[0]);
+	STORE_32(audio->psg.ch3.sample, 0, &state->audio.psg.ch2.reserved[1]);
+	STORE_16((audio->psg.ch3.rate & 0x7FF) | (audio->psg.ch4.sample << 11), 0, &state->audio.psg.ch3.reserved);
+	STORE_32(audio->psg.ch4.nSamples, 0, &state->audio.reserved[0]);
+	STORE_32(audio->psg.ch4.samples, 0, &state->audio.reserved[1]);
+
 	int readA = audio->chA.fifoRead;
 	int readB = audio->chB.fifoRead;
 	for (i = 0; i < GBA_AUDIO_FIFO_SIZE; ++i) {
@@ -503,15 +515,38 @@ void GBAAudioSerialize(const struct GBAAudio* audio, struct GBASerializedState*
 void GBAAudioDeserialize(struct GBAAudio* audio, const struct GBASerializedState* state) {
 	GBAudioPSGDeserialize(&audio->psg, &state->audio.psg, &state->audio.flags);
 
+	// A state from before these were saved holds zero in them, which is what a load gave
+	// the channels anyway.
+	int32_t value;
+	LOAD_32(value, 0, &state->audio.psg.ch1.reserved);
+	audio->psg.ch1.control.frequency = value & 0x7FF;
+	LOAD_32(value, 0, &state->audio.psg.ch2.reserved[0]);
+	audio->psg.ch2.control.frequency = value & 0x7FF;
+	LOAD_32(value, 0, &state->audio.psg.ch2.reserved[1]);
+	audio->psg.ch3.sample = value;
+	uint16_t rate;
+	LOAD_16(rate, 0, &state->audio.psg.ch3.reserved);
+	audio->psg.ch3.rate = rate & 0x7FF;
+	audio->psg.ch4.sample = rate >> 11;
+	LOAD_32(audio->psg.ch4.nSamples, 0, &state->audio.reserved[0]);
+	LOAD_32(audio->psg.ch4.samples, 0, &state->audio.reserved[1]);
+
+	// The IO block loads these four registers without writing them. Writing them here would
+	// run each channel up to the present, ahead of the mixer, and clock its length if the
+	// length enable bit turned on against the running console's, so set what they hold
+	// directly instead.
 	uint16_t reg;
 	LOAD_16(reg, GBA_REG_SOUND1CNT_X, state->io);
-	GBAIOWrite(audio->p, GBA_REG_SOUND1CNT_X, reg & 0x7FFF);
+	audio->psg.ch1.control.stop = GBAudioRegisterControlGetStop(reg);
 	LOAD_16(reg, GBA_REG_SOUND2CNT_HI, state->io);
-	GBAIOWrite(audio->p, GBA_REG_SOUND2CNT_HI, reg & 0x7FFF);
+	audio->psg.ch2.control.stop = GBAudioRegisterControlGetStop(reg);
 	LOAD_16(reg, GBA_REG_SOUND3CNT_X, state->io);
-	GBAIOWrite(audio->p, GBA_REG_SOUND3CNT_X, reg & 0x7FFF);
+	audio->psg.ch3.stop = GBAudioRegisterControlGetStop(reg);
 	LOAD_16(reg, GBA_REG_SOUND4CNT_HI, state->io);
-	GBAIOWrite(audio->p, GBA_REG_SOUND4CNT_HI, reg & 0x7FFF);
+	audio->psg.ch4.ratio = GBAudioRegisterNoiseFeedbackGetRatio((uint8_t) reg);
+	audio->psg.ch4.frequency = GBAudioRegisterNoiseFeedbackGetFrequency((uint8_t) reg);
+	audio->psg.ch4.power = GBAudioRegisterNoiseFeedbackGetPower((uint8_t) reg);
+	audio->psg.ch4.stop = GBAudioRegisterNoiseControlGetStop(reg >> 8);
 
 	LOAD_32(audio->chA.internalSample, 0, &state->audio.internalA);
 	LOAD_32(audio->chB.internalSample, 0, &state->audio.internalB);
